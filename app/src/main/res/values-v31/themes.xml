        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Monogram</item>
    </style>

    <style name="Theme.MonoGram.Startup.Dark" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/startup_background_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Monogram</item>
    </style>
</resources>
